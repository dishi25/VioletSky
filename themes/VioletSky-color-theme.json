{
    "$schema": "vscode://schemas/color-theme",
    "name": "VioletSky",
    "type": "dark",

    "colors": {
        "editor.background": "#181825",
        "editor.foreground": "#CDD6F4",

        "activityBar.background": "#11111B",
        "activityBar.foreground": "#CBA6F7",

        "sideBar.background": "#1E1E2E",
        "sideBar.foreground": "#CDD6F4",

        "sideBar.border": "#313244",

        "titleBar.activeBackground": "#181825",
        "titleBar.activeForeground": "#F5C2E7",

        "statusBar.background": "#CBA6F7",
        "statusBar.foreground": "#11111B",

        "editorCursor.foreground": "#F38BA8",

        "editor.lineHighlightBackground": "#313244",

        "editorLineNumber.foreground": "#6C7086",
        "editorLineNumber.activeForeground": "#F5C2E7",

        "editor.selectionBackground": "#585B70",
        "editor.selectionHighlightBackground": "#45475A",
        "editor.wordHighlightBackground": "#313244",

        "editor.findMatchBackground": "#F5C2E755",
        "editor.findMatchHighlightBackground": "#CBA6F722",

        "editorGroup.border": "#313244",
        "panel.border": "#313244",

        "terminal.background": "#181825",
        "terminal.foreground": "#CDD6F4",

        "terminal.ansiBlack": "#45475A",
        "terminal.ansiRed": "#F38BA8",
        "terminal.ansiGreen": "#A6E3A1",
        "terminal.ansiYellow": "#F9E2AF",
        "terminal.ansiBlue": "#89B4FA",
        "terminal.ansiMagenta": "#CBA6F7",
        "terminal.ansiCyan": "#94E2D5",
        "terminal.ansiWhite": "#BAC2DE",

        "tab.activeBackground": "#1E1E2E",
        "tab.inactiveBackground": "#11111B",

        "button.background": "#CBA6F7",
        "button.foreground": "#11111B",

        "input.background": "#313244",
        "input.foreground": "#CDD6F4",

        "quickInput.background": "#1E1E2E",
        "quickInput.foreground": "#CDD6F4",
        "quickInputTitle.background": "#11111B",

        "minimap.background": "#181825",

        "scrollbarSlider.background": "#6C708644",
        "scrollbarSlider.hoverBackground": "#CBA6F766"
    },

    "tokenColors": [
        {
            "scope": ["keyword"],
            "settings": {
                "foreground": "#F38BA8",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["keyword.operator"],
            "settings": {
                "foreground": "#89DCEB"
            }
        },
        {
            "scope": ["string"],
            "settings": {
                "foreground": "#A6E3A1"
            }
        },
        {
            "scope": ["comment"],
            "settings": {
                "foreground": "#c9aacb",
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["entity.name.function"],
            "settings": {
                "foreground": "#89B4FA"
            }
        },
        {
            "scope": ["entity.name.type.class"],
            "settings": {
                "foreground": "#F9E2AF"
            }
        },
        {
            "scope": ["variable"],
            "settings": {
                "foreground": "#F5C2E7"
            }
        },
        {
            "scope": ["variable.parameter"],
            "settings": {
                "foreground": "#FAB387"
            }
        },
        {
            "scope": ["constant.numeric"],
            "settings": {
                "foreground": "#FAB387"
            }
        },
        {
            "scope": ["storage.type"],
            "settings": {
                "foreground": "#CBA6F7"
            }
        },
        {
            "scope": ["markup.heading"],
            "settings": {
                "foreground": "#CBA6F7",
                "fontStyle": "bold"
            }
        }
    ],

    "semanticHighlighting": true,

    "semanticTokenColors": {
        "function": "#89B4FA",
        "method": "#89B4FA",

        "variable": "#F5C2E7",
        "parameter": "#FAB387",
        "property": "#94E2D5",

        "class": "#F9E2AF",
        "interface": "#F9E2AF",
        "enum": "#CBA6F7",

        "keyword": "#F38BA8"
    }
}